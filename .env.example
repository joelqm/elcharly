# === Desarrollo local ===
# DEBUG=True
# SECRET_KEY=django-insecure-example-key-replace-this-in-production
# ALLOWED_HOSTS=127.0.0.1,localhost

# === Producción (servidor + Nginx Proxy Manager) ===
DEBUG=False
SECRET_KEY=cambia-por-una-clave-larga-aleatoria-minimo-50-chars
ALLOWED_HOSTS=makitaelcharly.com,www.makitaelcharly.com,127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=https://makitaelcharly.com,https://www.makitaelcharly.com
# HTTPS lo fuerza NPM (Force SSL). No activar redirect en Django.
SECURE_SSL_REDIRECT=False
ENABLE_HSTS=True

# Tienda online pública. False = “en construcción” (POS/sistema interno sí operan).
WEB_PUBLICA_ACTIVA=False

# Base de Datos (Docker Compose inyecta DATABASE_URL al contenedor web_prod)
POSTGRES_DB=makita_db
POSTGRES_USER=makita_user
POSTGRES_PASSWORD=cambia-esta-clave-en-produccion
DATABASE_URL=postgres://makita_user:cambia-esta-clave-en-produccion@127.0.0.1:5435/makita_db

# Correo (consola hasta configurar SMTP)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@makitaelcharly.com
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True

# Consulta DNI/RUC (Decolecta — apis.net.pe migró aquí)
# CONSULTA_DOCUMENTO_PROVIDER=decolecta
# CONSULTA_DOCUMENTO_TOKEN=

# SLA taller (días)
MANTENIMIENTO_SLA_DIAS=5
